{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["chrome"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "../internal/browser/extension"
  },
  "include": ["src/**/*.ts"]
}
