{
  "manifest_version": 3,
  "name": "Local Runtime MCP Browser Bridge",
  "version": "9.0.2",
  "description": "Lets Local Runtime MCP control the current Chromium browser through an authenticated local bridge.",
  "homepage_url": "https://github.com/hicancan/local-runtime-mcp",
  "permissions": [
    "debugger",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Local Runtime MCP Browser Bridge"
  }
}
